---
import "@/styles/fonts.css";
import "@/styles/icons.css";
import "@/styles/global.css";
import "@/styles/phase6.css";
import PhaseSixUI from "@/components/PhaseSixUI.astro";

interface Props {
  title: string;
  description: string;
  structuredData?: Record<string, unknown>;
  robots?: string;
  image?: string;
}

const { title, description, structuredData, robots = "index, follow", image = "/images/hero-ultrasound-lab.webp" } = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImageUrl = new URL(image, Astro.site || Astro.url);
const seoDescription = description.length > 160 ? `${description.slice(0, 157).trimEnd()}…` : description;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={seoDescription} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f9fafc" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="THIÊN LỘC GROUP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%23006fb6%22/><path d=%22M14 7h4v7h7v4h-7v7h-4v-7H7v-4h7z%22 fill=%22white%22/></svg>" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
    <slot />
    <PhaseSixUI />
    <script>
      import "@/scripts/interactions";
    </script>
  </body>
</html>
