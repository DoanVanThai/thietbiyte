---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import MedicalProductSection from "@/components/MedicalProductSection.astro";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import { articles, solutions } from "@/data/homepage";
import type { MedicalSpecialtyConfig } from "@/data/medical";
import { productService } from "@/server/services/product-service";
import "@/styles/catalog.css";
import "@/styles/medical.css";

interface Props {
  specialty: MedicalSpecialtyConfig;
}

const { specialty } = Astro.props;
const products = (await productService.listPublicCatalog())
  .filter((product) => product.group === "medical" && product.specialtySlugs.includes(specialty.slug))
  .sort((a, b) => b.featured - a.featured)
  .slice(0, 4);
const relatedSolutions = solutions.filter(([title]) => specialty.solutionLabels.includes(title));
const relatedArticles = specialty.knowledgeIndexes.map((index) => articles[index]).filter(Boolean);
const catalogHref = `/san-pham?group=medical&specialty=${specialty.slug}`;
---

<BaseLayout
  title={`${specialty.title} | THIÊN LỘC GROUP`}
  description={specialty.description}
>
  <Header />
  <main id="main-content" class="medical-specialty-page">
    <section class="specialty-hero" aria-labelledby="specialty-title">
      <div class="container">
        <Breadcrumb items={[
          { label: "Trang chủ", href: "/" },
          { label: "Thiết bị Y tế", href: "/y-te" },
          { label: specialty.title },
        ]} />
        <div class="specialty-hero-layout">
          <div>
            <h1 id="specialty-title">{specialty.title}</h1>
            <p>{specialty.description}</p>
            <div class="specialty-hero-actions">
              <a class="button button-primary" href="#specialty-categories">Khám phá nhóm thiết bị</a>
              <a class="button button-outline" href={catalogHref}>Xem sản phẩm</a>
            </div>
          </div>
          <figure>
            <ResponsiveImage src={specialty.image} alt={`Ảnh minh họa thiết bị cho chuyên khoa ${specialty.title}`} width={1200} height={800} sourceWidth={specialty.image.includes("hero-ultrasound") ? 1600 : 1400} sizes="(max-width: 767px) 100vw, 50vw" loading="eager" fetchpriority="high" style={`object-position:${specialty.imagePosition}`} />
          </figure>
        </div>
      </div>
    </section>

    <section class="specialty-discovery" id="specialty-categories" aria-labelledby="specialty-categories-title">
      <div class="container specialty-discovery-layout">
        <div class="specialty-discovery-intro">
          <h2 id="specialty-categories-title">Tìm thiết bị cho {specialty.title}</h2>
          <p>Chọn nhu cầu trước, sau đó đi tiếp đến danh mục và sản phẩm phù hợp.</p>
          <nav class="specialty-needs" aria-label={`Nhu cầu ${specialty.title}`}>
            {specialty.needs.map((need) => <a href={`${catalogHref}&q=${encodeURIComponent(need)}`}>{need}</a>)}
          </nav>
        </div>

        <nav class="specialty-subcategories" aria-label={`Nhóm thiết bị ${specialty.title}`}>
          {specialty.subcategories.map((subcategory) => (
            <a href={`${catalogHref}&q=${encodeURIComponent(subcategory)}`}>
              <span><strong>{subcategory}</strong><small>Mở sản phẩm và cấu hình liên quan</small></span>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <MedicalProductSection
      title="Thiết bị liên quan"
      description={`Sản phẩm Y tế hiện có dữ liệu chuyên khoa ${specialty.title}.`}
      products={products}
      viewAllHref={catalogHref}
      emptyDescription={`Dữ liệu sản phẩm cho ${specialty.title} đang được hoàn thiện. Bạn vẫn có thể gửi nhu cầu để được hỗ trợ tìm cấu hình.`}
    />

    <section class="specialty-support" aria-label={`Giải pháp và kiến thức ${specialty.title}`}>
      <div class="container specialty-support-grid">
        <section aria-labelledby="specialty-solutions-title">
          <header>
            <h2 id="specialty-solutions-title">Giải pháp liên quan</h2>
            <p>Tham khảo cách tổ chức thiết bị theo mô hình cơ sở.</p>
          </header>
          <div class="specialty-solution-list">
            {relatedSolutions.map(([title, description, image]) => (
              <article>
                <ResponsiveImage src={image} alt={`Ảnh minh họa ${title}`} width={560} height={373} sourceWidth={image.includes("hero-ultrasound") ? 1600 : 1400} sizes="(max-width: 767px) 100vw, 280px" />
                <div><h3>{title}</h3><p>{description}</p><a href={`/?solution=${encodeURIComponent(title)}#solutions`}>Xem giải pháp<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
              </article>
            ))}
          </div>
        </section>

        <section aria-labelledby="specialty-knowledge-title">
          <header>
            <h2 id="specialty-knowledge-title">Kiến thức tham khảo</h2>
            <p>Chuẩn bị tiêu chí lựa chọn, hồ sơ và kế hoạch vận hành thiết bị.</p>
          </header>
          <div class="specialty-knowledge-list">
            {relatedArticles.map(([category, title, excerpt]) => (
              <article>
                <span>{category}</span>
                <h3><a href={`/?article=${encodeURIComponent(title)}#knowledge`}>{title}</a></h3>
                <p>{excerpt}</p>
              </article>
            ))}
          </div>
        </section>
      </div>
    </section>

    <section class="specialty-cta" aria-labelledby="specialty-cta-title">
      <div class="container specialty-cta-layout">
        <div>
          <h2 id="specialty-cta-title">Cần tư vấn danh mục thiết bị cho chuyên khoa này?</h2>
          <p>Gửi nhu cầu sử dụng, quy mô cơ sở và nhóm thiết bị đang quan tâm để đội ngũ tư vấn chuẩn bị cấu hình.</p>
        </div>
        <a class="button button-primary button-lg" href={`/yeu-cau-bao-gia?source=solution&need=${encodeURIComponent(`Tôi cần tư vấn cấu hình ${specialty.title}`)}`}>Nhận tư vấn cấu hình</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
