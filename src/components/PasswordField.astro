---
interface Props {
  id: string;
  name: string;
  label: string;
  autocomplete: string;
  confirm?: boolean;
  requirementsId?: string;
  minLength?: number;
}

const { id, name, label, autocomplete, confirm = false, requirementsId, minLength = 10 } = Astro.props;
const errorId = `${id}-error`;
const describedBy = [requirementsId, errorId].filter(Boolean).join(" ");
---

<div class="field" data-field>
  <label for={id}>{label}</label>
  <div class="password-control">
    <input
      id={id}
      name={name}
      type="password"
      autocomplete={autocomplete}
      minlength={minLength}
      required
      aria-describedby={describedBy}
      aria-errormessage={errorId}
      data-password={confirm ? undefined : "primary"}
      data-password-confirm={confirm ? "true" : undefined}
    />
    <button class="password-toggle" type="button" data-password-toggle aria-label={`Hiện ${label.toLocaleLowerCase("vi")}`} aria-pressed="false">
      <i class="ph ph-eye" aria-hidden="true"></i>
    </button>
  </div>
  <p class="field-error" id={errorId} data-field-error aria-live="polite"></p>
</div>
