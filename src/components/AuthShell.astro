---
import AuthBrand from "./AuthBrand.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<header class="auth-header">
  <AuthBrand />
  <a class="auth-home-link" href="/"><i class="ph ph-arrow-left" aria-hidden="true"></i>Về trang chủ</a>
</header>

<main id="main-content" class="auth-main">
  <section class:list={["auth-panel", wide && "auth-panel-wide"]} aria-labelledby="auth-title">
    <div class="auth-heading">
      <h1 id="auth-title">{title}</h1>
      {description && <p>{description}</p>}
    </div>
    <slot />
  </section>
</main>

<footer class="auth-footer">
  <span>© 2026 THIÊN LỘC GROUP</span>
  <nav aria-label="Liên kết hỗ trợ">
    <a href="mailto:info@thienlocgroup.com">Hỗ trợ</a>
    <a href="/#privacy">Bảo mật</a>
  </nav>
</footer>
