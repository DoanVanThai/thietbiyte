---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import CatalogProductCard from "@/components/CatalogProductCard.astro";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import { productService } from "@/server/services/product-service";
import { getEntities } from "@/lib/content-repository";
import "@/styles/catalog.css";
import "@/styles/veterinary.css";

const veterinaryProducts = (await productService.listPublicCatalog())
  .filter((product) => product.group === "veterinary")
  .sort((a, b) => b.featured - a.featured);

const categoryFallbacks = [
  { label: "Chẩn đoán hình ảnh", icon: "ph-scan", filter: "chan-doan-hinh-anh", available: 2 },
  { label: "Siêu âm thú y", icon: "ph-waveform", filter: "sieu-am-thu-y", available: 1 },
  { label: "X-quang thú y", icon: "ph-radioactive", filter: "x-quang-thu-y", available: 1 },
  { label: "Xét nghiệm", icon: "ph-test-tube", filter: "xet-nghiem", available: 0 },
  { label: "Gây mê", icon: "ph-wind", filter: "gay-me-thu-y", available: 1 },
  { label: "Monitoring", icon: "ph-heartbeat", filter: "monitoring-thu-y", available: 1 },
  { label: "Phẫu thuật", icon: "ph-first-aid-kit", filter: "phau-thuat", available: 1 },
  { label: "ICU", icon: "ph-pulse", filter: "icu", available: 1 },
  { label: "Nội soi", icon: "ph-camera", filter: "noi-soi", available: 0 },
  { label: "Nha khoa thú y", icon: "ph-tooth", filter: "nha-khoa-thu-y", available: 0 },
  { label: "Vật tư", icon: "ph-package", filter: "vat-tu", available: 0 },
] as const;
const veterinaryCategoryEntities = getEntities("category").filter((entity) => (entity.type || entity.data?.type) === "veterinary");
const categorySources = veterinaryCategoryEntities.length
  ? veterinaryCategoryEntities.map((entity) => ({ label: entity.name, icon: "ph-folders", filter: entity.slug }))
  : categoryFallbacks.map(({ label, icon, filter }) => ({ label, icon, filter }));
const categories = categorySources.map((category) => ({
  ...category,
  available: veterinaryProducts.filter((product) => product.categorySlug === category.filter || product.specialtySlugs.includes(category.filter) || product.applicationSlugs.includes(category.filter)).length,
}));

const solutions = [
  {
    title: "Phòng khám thú y cơ bản",
    icon: "ph-stethoscope",
    need: "Khám ban đầu, chẩn đoán thường quy và xử lý các ca ngoại trú với quy trình gọn.",
    equipment: "Siêu âm, monitoring cơ bản, bàn khám và bộ dụng cụ thủ thuật.",
    configuration: "01 máy siêu âm thú y + 01 monitor đa thông số, cấu hình đầu dò và phụ kiện theo nhóm bệnh nhân.",
    related: ["may-sieu-am-thu-y-vet-us-09", "monitor-thu-y-vet-mon-12"],
  },
  {
    title: "Bệnh viện thú y",
    icon: "ph-buildings",
    need: "Tiếp nhận đa chuyên khoa, vận hành liên tục và phối hợp dữ liệu giữa chẩn đoán, điều trị, lưu viện.",
    equipment: "Siêu âm, X-quang DR, gây mê, monitoring và thiết bị hồi sức.",
    configuration: "Cấu hình đồng bộ 4 nhóm thiết bị cốt lõi, có dự phòng vận hành và kế hoạch đào tạo theo khoa.",
    related: veterinaryProducts.map((product) => product.slug),
  },
  {
    title: "Phòng phẫu thuật thú y",
    icon: "ph-first-aid",
    need: "Kiểm soát gây mê, theo dõi sinh hiệu và duy trì quy trình phẫu thuật an toàn.",
    equipment: "Máy gây mê, monitor đa thông số, bàn mổ, đèn mổ và bộ dụng cụ.",
    configuration: "01 máy gây mê kèm hệ thống thở + 01 monitor, lựa chọn phụ kiện theo loài và quy mô phẫu thuật.",
    related: ["may-gay-me-thu-y-vet-an-11", "monitor-thu-y-vet-mon-12"],
  },
  {
    title: "Phòng xét nghiệm thú y",
    icon: "ph-flask",
    need: "Trả kết quả huyết học, sinh hóa và xét nghiệm hỗ trợ điều trị ngay tại cơ sở.",
    equipment: "Máy huyết học, sinh hóa, ly tâm, kính hiển vi và hệ thống quản lý mẫu.",
    configuration: "Thiết kế theo sản lượng mẫu/ngày và danh mục xét nghiệm; cần khảo sát trước khi chốt cấu hình.",
    related: [],
  },
  {
    title: "Chẩn đoán hình ảnh thú y",
    icon: "ph-scan",
    need: "Hình ảnh có độ tin cậy cho khám tổng quát, tim mạch, ổ bụng và cơ xương khớp.",
    equipment: "Siêu âm màu, hệ thống X-quang DR và trạm xử lý hình ảnh.",
    configuration: "01 hệ thống siêu âm với bộ đầu dò phù hợp + 01 X-quang DR chuyên dụng, bố trí theo mặt bằng và an toàn bức xạ.",
    related: ["may-sieu-am-thu-y-vet-us-09", "he-thong-x-quang-thu-y-vet-dr-10"],
  },
  {
    title: "ICU thú y",
    icon: "ph-heartbeat",
    need: "Theo dõi liên tục bệnh nhân nặng, hậu phẫu và các ca cần can thiệp kịp thời.",
    equipment: "Monitor đa thông số, oxy, bơm truyền và thiết bị hỗ trợ nhiệt.",
    configuration: "Monitor có preset theo loài và phụ kiện phù hợp kích thước bệnh nhân; mở rộng theo số giường ICU.",
    related: ["monitor-thu-y-vet-mon-12"],
  },
] as const;

const productBySlug = new Map(veterinaryProducts.map((product) => [product.slug, product]));
const consultationHref = "/yeu-cau-bao-gia?source=solution&need=Setup%20phòng%20khám%20thú%20y";
---

<BaseLayout
  title="Thiết bị Thú y | THIÊN LỘC GROUP"
  description="Giải pháp thiết bị chẩn đoán, xét nghiệm, gây mê, monitoring và phẫu thuật dành cho phòng khám và bệnh viện thú y."
>
  <Header />
  <main id="main-content" class="veterinary-page">
    <section class="vet-hero" aria-labelledby="vet-title">
      <div class="container">
        <Breadcrumb items={[{ label: "Trang chủ", href: "/" }, { label: "Thiết bị Thú y" }]} />
        <div class="vet-hero-grid">
          <div class="vet-hero-copy">
            <h1 id="vet-title">Thiết bị Thú y</h1>
            <p class="vet-hero-lead">Giải pháp thiết bị chẩn đoán, xét nghiệm, gây mê, monitoring và phẫu thuật dành cho phòng khám và bệnh viện thú y.</p>
            <div class="cta-group">
              <a class="button button-primary button-lg" href="#danh-muc">Khám phá danh mục <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
              <a class="button button-outline button-lg" href={consultationHref}>Nhận tư vấn thiết bị</a>
            </div>
          </div>
          <figure class="vet-hero-media">
            <ResponsiveImage src="/images/veterinary-diagnostic-room.webp" alt="Phòng chẩn đoán thú y với hệ thống siêu âm và monitoring" width={1400} height={934} sourceWidth={1400} sizes="(max-width: 767px) 100vw, 50vw" loading="eager" fetchpriority="high" />
            <figcaption><i class="ph ph-shield-check" aria-hidden="true"></i> Thiết kế cấu hình theo quy trình khám và điều trị</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section vet-categories" id="danh-muc" aria-labelledby="vet-category-title">
      <div class="container">
        <div class="section-heading vet-section-heading">
          <div>
            <h2 id="vet-category-title">Tìm thiết bị theo nhu cầu</h2>
            <p>Đi từ nhóm chuyên môn đến cấu hình phù hợp cho cơ sở thú y của bạn.</p>
          </div>
          <a class="text-link" href="#giai-phap">Xem giải pháp tổng thể <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="vet-category-grid">
          {categories.map((category) => (
            <a class="vet-category-card" href={`?category=${category.filter}#san-pham-noi-bat`}>
              <span class="vet-category-icon"><i class={`ph ${category.icon}`} aria-hidden="true"></i></span>
              <span>
                <strong>{category.label}</strong>
                <small>{category.available > 0 ? `${category.available} thiết bị hiện có` : "Nhận cấu hình theo nhu cầu"}</small>
              </span>
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section vet-featured" id="san-pham-noi-bat" aria-labelledby="vet-featured-title" data-vet-products>
      <div class="container">
        <div class="section-heading vet-section-heading">
          <div>
            <h2 id="vet-featured-title">Thiết bị nổi bật</h2>
            <p data-vet-product-summary>Danh sách được chọn lọc riêng cho quy trình khám và điều trị thú y.</p>
          </div>
          <button class="button button-outline button-sm vet-clear-filter" type="button" data-vet-clear-filter hidden>Xem tất cả sản phẩm thú y</button>
        </div>
        <div class="vet-product-grid">
          {veterinaryProducts.map((product) => (
            <div data-vet-product-category={product.categorySlug} data-vet-product-slug={product.slug}>
              <CatalogProductCard product={product} headingLevel="h3" />
            </div>
          ))}
        </div>
        <div class="vet-product-empty" data-vet-product-empty hidden>
          <span><i class="ph ph-clipboard-text" aria-hidden="true"></i></span>
          <h3>Cần xây dựng cấu hình theo nhu cầu</h3>
          <p>Danh mục này chưa có sản phẩm công khai trong dữ liệu hiện tại. Đội ngũ kỹ thuật sẽ đề xuất cấu hình dựa trên quy mô và quy trình vận hành của bạn.</p>
          <a class="button button-primary" href={consultationHref}>Nhận tư vấn thiết bị</a>
        </div>
      </div>
    </section>

    <section class="section vet-solutions" id="giai-phap" aria-labelledby="vet-solutions-title">
      <div class="container">
        <div class="section-heading vet-section-heading">
          <div>
            <h2 id="vet-solutions-title">Cấu hình cho từng quy mô vận hành</h2>
            <p>Mỗi giải pháp kết nối nhu cầu lâm sàng, nhóm thiết bị và cấu hình đề xuất trong một lộ trình triển khai.</p>
          </div>
        </div>
        <div class="vet-solution-list">
          {solutions.map((solution, index) => (
            <details class="vet-solution" open={index === 0}>
              <summary>
                <span class="vet-solution-title"><i class={`ph ${solution.icon}`} aria-hidden="true"></i><strong>{solution.title}</strong></span>
                <span class="vet-solution-toggle"><span>Xem cấu hình</span><i class="ph ph-plus" aria-hidden="true"></i></span>
              </summary>
              <div class="vet-solution-body">
                <div class="vet-solution-specs">
                  <div><span>Nhu cầu</span><p>{solution.need}</p></div>
                  <div><span>Thiết bị cần thiết</span><p>{solution.equipment}</p></div>
                  <div><span>Cấu hình đề xuất</span><p>{solution.configuration}</p></div>
                </div>
                <aside class="vet-related-products" aria-label={`Sản phẩm liên quan cho ${solution.title}`}>
                  <span>Sản phẩm liên quan</span>
                  {solution.related.length > 0 ? (
                    <ul>
                      {solution.related.map((slug) => {
                        const product = productBySlug.get(slug);
                        return product && <li><a href={`/san-pham/${product.slug}`}>{product.name}<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></li>;
                      })}
                    </ul>
                  ) : <p>Cấu hình sản phẩm cần được xác nhận sau khảo sát.</p>}
                  <a class="button button-outline button-sm" href={`/yeu-cau-bao-gia?source=solution&need=${encodeURIComponent(`Tôi cần tư vấn cấu hình: ${solution.title}`)}&products=${encodeURIComponent(solution.related.join(","))}`}>Yêu cầu tư vấn</a>
                </aside>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="vet-cta" aria-labelledby="vet-cta-title">
      <div class="container vet-cta-inner">
        <div>
          <h2 id="vet-cta-title">Bạn đang setup phòng khám thú y?</h2>
          <p>Chia sẻ quy mô, nhóm dịch vụ và mặt bằng dự kiến. Thiên Lộc Group sẽ hỗ trợ xây dựng danh mục thiết bị phù hợp.</p>
        </div>
        <a class="button button-primary button-lg" href={consultationHref}>Nhận tư vấn thiết bị <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-vet-products]");

  if (root) {
    const categoryGroups: Record<string, string[]> = {
      "chan-doan-hinh-anh": ["sieu-am-thu-y", "x-quang-thu-y"],
      "phau-thuat": ["gay-me-thu-y"],
      "icu": ["monitoring-thu-y"],
    };
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-vet-product-category]"));
    const empty = root.querySelector<HTMLElement>("[data-vet-product-empty]");
    const clear = root.querySelector<HTMLButtonElement>("[data-vet-clear-filter]");
    const summary = root.querySelector<HTMLElement>("[data-vet-product-summary]");
    const category = new URL(window.location.href).searchParams.get("category") || "";

    const renderCategory = (value: string) => {
      const accepted = categoryGroups[value] || (value ? [value] : []);
      let visible = 0;
      cards.forEach((card) => {
        const show = accepted.length === 0 || accepted.includes(card.dataset.vetProductCategory || "");
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      if (clear) clear.hidden = !value;
      if (summary) summary.textContent = value
        ? visible > 0 ? `${visible} thiết bị thú y phù hợp với danh mục đang chọn.` : "Danh mục đang chọn cần được tư vấn và xây dựng cấu hình riêng."
        : "Danh sách được chọn lọc riêng cho quy trình khám và điều trị thú y.";
    };

    renderCategory(category);
    clear?.addEventListener("click", () => {
      const url = new URL(window.location.href);
      url.searchParams.delete("category");
      window.history.replaceState({}, "", url);
      renderCategory("");
    });
  }
</script>
