---
import CatalogPage from "@/components/CatalogPage.astro";
import { routeConfig } from "@/lib/public-content";
const config = await routeConfig("category", Astro.params.slug || "");
if (!config) return new Response("Không tìm thấy danh mục", { status: 404 });
---

<CatalogPage config={config} />
