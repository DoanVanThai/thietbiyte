---
import CrmShell from "@/components/CrmShell.astro";
import { customerTypes } from "@/data/crm";
import { crmViewCustomers, crmViewSales } from "@/server/crm-view";
const crmCustomers = await crmViewCustomers(Astro.locals.auth!);
const salesPeople = await crmViewSales();
---
<CrmShell title="Customers" description="Hồ sơ khách hàng, sản phẩm và lịch sử làm việc." active="customers" section="CRM · Customers">
  <header class="crm-page-header"><div><p>CRM</p><h1>Customers</h1><span>Hồ sơ khách hàng đã đủ điều kiện hoặc có giao dịch báo giá.</span></div><button class="button button-primary" type="button" data-demo-action="new-customer"><i class="ph ph-plus" aria-hidden="true"></i>Thêm customer</button></header>
  <form class="crm-filter-bar crm-filter-compact" data-crm-filters><label class="crm-filter-search"><span>Tìm kiếm</span><div><i class="ph ph-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Tên, đơn vị, điện thoại..." data-filter-search /></div></label><label><span>Sales Owner</span><select data-filter-key="sales"><option value="">Tất cả</option>{salesPeople.map((sales) => <option>{sales}</option>)}</select></label><label><span>Customer Type</span><select data-filter-key="customerType"><option value="">Tất cả</option>{customerTypes.map((type) => <option>{type}</option>)}</select></label><button class="crm-filter-reset" type="reset" data-filter-reset><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Đặt lại</button></form>
  <div class="crm-list-toolbar"><p><strong data-result-count>{crmCustomers.length}</strong> customers</p></div>
  <div class="crm-table-wrap"><table class="crm-table"><caption class="sr-only">Danh sách khách hàng</caption><thead><tr><th scope="col">Customer</th><th scope="col">Organization</th><th scope="col">Contact</th><th scope="col">Type</th><th scope="col">Products</th><th scope="col">Quotes</th><th scope="col">Sales Owner</th><th scope="col">Last Activity</th><th scope="col"><span class="sr-only">Thao tác</span></th></tr></thead><tbody>{crmCustomers.map((customer) => <tr data-filter-row data-search={`${customer.name} ${customer.organization} ${customer.phone}`} data-sales={customer.salesOwner} data-customer-type={customer.type}><td><a href={`/admin/crm/customers/${customer.id}`}><strong>{customer.name}</strong><small>{customer.id}</small></a></td><td>{customer.organization}</td><td><a href={`tel:${customer.phone.replace(/\s/g, "")}`}>{customer.phone}</a><small>{customer.email}</small></td><td>{customer.type}</td><td>{customer.products.length}</td><td>{customer.quoteIds.length}</td><td>{customer.salesOwner}</td><td>{customer.activities[0]?.date || "Chưa có"}</td><td><a class="crm-row-open" href={`/admin/crm/customers/${customer.id}`} aria-label={`Mở ${customer.name}`}><i class="ph ph-caret-right" aria-hidden="true"></i></a></td></tr>)}</tbody></table></div>
  <div class="crm-mobile-list">{crmCustomers.map((customer) => <article data-filter-row data-search={`${customer.name} ${customer.organization} ${customer.phone}`} data-sales={customer.salesOwner} data-customer-type={customer.type}><header><div><a href={`/admin/crm/customers/${customer.id}`}>{customer.name}</a><span>{customer.organization}</span></div><span class="crm-neutral-label">{customer.type}</span></header><dl><div><dt>Phone</dt><dd>{customer.phone}</dd></div><div><dt>Quotes</dt><dd>{customer.quoteIds.length}</dd></div><div><dt>Sales</dt><dd>{customer.salesOwner}</dd></div></dl><footer><a href={`tel:${customer.phone.replace(/\s/g, "")}`}><i class="ph ph-phone" aria-hidden="true"></i>Gọi</a><a href={`/admin/crm/customers/${customer.id}`}><i class="ph ph-arrow-right" aria-hidden="true"></i>Xem profile</a></footer></article>)}</div>
  <div class="crm-empty-state" data-filter-empty hidden><i class="ph ph-users-three" aria-hidden="true"></i><h2>Không có customer phù hợp</h2><button class="button button-outline" type="button" data-empty-reset>Xóa bộ lọc</button></div>
</CrmShell>
