---
import CrmShell from "@/components/CrmShell.astro";
import { crmViewActivities, crmViewSales } from "@/server/crm-view";
const crmActivities = await crmViewActivities(Astro.locals.auth!);
const salesPeople = await crmViewSales();
const icons = { call: "phone", email: "envelope", zalo: "chat-circle-dots", meeting: "calendar", quote: "file-text", note: "note", status: "arrows-clockwise" };
const types = [["call", "Call"], ["email", "Email"], ["zalo", "Zalo"], ["meeting", "Meeting"], ["quote", "Quote"], ["note", "Note"], ["status", "Status Change"]] as const;
---
<CrmShell title="Activities" description="Lịch sử tương tác của Sales với leads và customers." active="activities" section="CRM · Activities">
  <header class="crm-page-header"><div><p>CRM</p><h1>Activities</h1><span>Một timeline thống nhất cho call, email, Zalo, meeting, quote, note và status change.</span></div><a class="button button-primary" href="/admin/crm"><i class="ph ph-plus" aria-hidden="true"></i>Chọn lead để ghi</a></header>
  <form class="crm-filter-bar crm-filter-compact" data-crm-filters><label class="crm-filter-search"><span>Tìm kiếm</span><div><i class="ph ph-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Lead, organization, nội dung..." data-filter-search /></div></label><label><span>Type</span><select data-filter-key="type"><option value="">Tất cả</option>{types.map(([value, label]) => <option value={value}>{label}</option>)}</select></label><label><span>Sales</span><select data-filter-key="sales"><option value="">Tất cả</option>{salesPeople.map((sales) => <option>{sales}</option>)}</select></label><label><span>Từ ngày</span><input type="date" /></label><button class="crm-filter-reset" type="reset" data-filter-reset><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i>Đặt lại</button></form>
  <div class="crm-list-toolbar"><p><strong data-result-count>{crmActivities.length}</strong> activities</p></div>
  <div class="activity-log-list">{crmActivities.map((activity) => <article data-filter-row data-search={`${activity.title} ${activity.detail} ${activity.leadName} ${activity.organization}`} data-type={activity.type} data-sales={activity.actor}><span class="activity-log-icon"><i class={`ph ph-${icons[activity.type]}`} aria-hidden="true"></i></span><div><header><a href={`/admin/crm/leads/${activity.leadId}`}>{activity.title}</a><span class={`visibility-label visibility-${activity.visibility}`}><i class={`ph ${activity.visibility === "internal" ? "ph-lock-key" : "ph-eye"}`} aria-hidden="true"></i>{activity.visibility === "internal" ? "Nội bộ" : "Khách hàng thấy"}</span></header><p>{activity.detail}</p><footer><span>{activity.leadName} · {activity.organization}</span><small>{activity.actor} · {activity.date}</small></footer></div><a class="crm-row-open" href={`/admin/crm/leads/${activity.leadId}`} aria-label={`Mở ${activity.leadName}`}><i class="ph ph-caret-right" aria-hidden="true"></i></a></article>)}</div>
  <div class="crm-empty-state" data-filter-empty hidden><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i><h2>Không có hoạt động phù hợp</h2><button class="button button-outline" type="button" data-empty-reset>Xóa bộ lọc</button></div>
</CrmShell>
