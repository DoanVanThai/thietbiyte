---
import CrmShell from "@/components/CrmShell.astro";
import CrmStatus from "@/components/CrmStatus.astro";
import ActivityTimeline from "@/components/ActivityTimeline.astro";
import { formatCrmCurrency, quoteStatusLabels } from "@/data/crm";
import { crmViewQuote, crmViewSalesOptions } from "@/server/crm-view";
const result = await crmViewQuote(String(Astro.params.id), Astro.locals.auth!);
if (!result) return Astro.redirect("/404", 302);
const runtime = "quote" in result;
const quote = runtime ? result.quote : result;
const recordId = runtime ? result.recordId : quote.id;
const databaseStatus = runtime ? result.status : "";
const assignedToId = runtime ? result.assignedToId : "";
const salesOptions = await crmViewSalesOptions();
---
<CrmShell title={quote.id} description={`Chi tiết báo giá ${quote.id}`} active="quotes" section={`CRM · ${quote.id}`}>
  <span hidden data-crm-record-id={recordId} data-crm-entity="quote"></span>
  <a class="crm-back-link" href="/admin/crm/quotes"><i class="ph ph-arrow-left" aria-hidden="true"></i>Quay lại Quotes</a>
  <header class="quote-admin-header"><div><p>Quote ID</p><h1>{quote.id}</h1><span>{quote.customer} · {quote.organization}</span></div><div><CrmStatus status={quote.status} kind="quote" /><button class="button button-outline" type="button" data-demo-action="duplicate"><i class="ph ph-copy" aria-hidden="true"></i>Nhân bản</button><button class="button button-primary" type="button" data-send-quote disabled={databaseStatus === "QUOTE_SENT" || databaseStatus === "COMPLETED" || databaseStatus === "CANCELLED"}><i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>Đánh dấu đã gửi</button></div></header>
  <div class="quote-admin-layout">
    <div class="quote-admin-main">
      <section class="crm-section"><header class="crm-section-header"><div><h2>Customer</h2><p>Thông tin sẽ xuất hiện trên báo giá gửi khách hàng.</p></div><span class="visibility-label visibility-customer"><i class="ph ph-eye" aria-hidden="true"></i>Customer-visible</span></header><dl class="quote-customer-data"><div><dt>Customer</dt><dd>{quote.customer}</dd></div><div><dt>Organization</dt><dd>{quote.organization}</dd></div><div><dt>Customer requirement</dt><dd>{quote.requirement}</dd></div></dl></section>
      <section class="crm-section"><header class="crm-section-header"><div><h2>Products</h2><p>Sản phẩm, model và số lượng.</p></div><span class="visibility-label visibility-customer"><i class="ph ph-eye" aria-hidden="true"></i>Customer-visible</span></header><div class="quote-admin-products">{quote.products.map((product) => <article><i class="ph ph-package" aria-hidden="true"></i><div><strong>{product.name}</strong><span>{product.model}</span></div><dl><div><dt>Quantity</dt><dd>{product.quantity}</dd></div><div><dt>Đơn giá</dt><dd>{formatCrmCurrency(product.unitPrice)}</dd></div></dl></article>)}</div><footer class="quote-value-total"><span>Tổng giá trị dự kiến</span><strong>{formatCrmCurrency(quote.value)}</strong></footer></section>
      <section class="crm-section"><header class="crm-section-header"><div><h2>Attachments</h2><p>Kiểm tra visibility trước khi gửi.</p></div><button class="crm-text-action" type="button" data-demo-action="upload"><i class="ph ph-upload-simple" aria-hidden="true"></i>Tải lên</button></header>{quote.attachments.length ? <div class="crm-document-list">{quote.attachments.map((file) => <article><i class="ph ph-file" aria-hidden="true"></i><span><strong>{file.name}</strong><small>{file.meta}</small></span><span class={`visibility-label visibility-${file.visibility}`}>{file.visibility === "internal" ? "Internal-only" : "Customer-visible"}</span><button type="button" data-demo-action="download" aria-label={`Tải ${file.name}`}><i class="ph ph-download-simple" aria-hidden="true"></i></button></article>)}</div> : <div class="crm-compact-empty"><i class="ph ph-folder-open" aria-hidden="true"></i><span>Chưa có tệp đính kèm.</span></div>}</section>
      <section class="crm-section internal-section"><header class="crm-section-header"><div><h2>Internal notes</h2><p>Không hiển thị trên báo giá hoặc User Portal.</p></div><span class="visibility-label visibility-internal"><i class="ph ph-lock-key" aria-hidden="true"></i>Internal-only</span></header><div class="internal-warning"><i class="ph ph-warning-circle" aria-hidden="true"></i><span><strong>Chỉ dành cho staff</strong>Không sao chép nội dung phần này sang trường customer-visible.</span></div><ul class="quote-internal-notes">{quote.internalNotes.length ? quote.internalNotes.map((note) => <li>{note}</li>) : <li>Chưa có ghi chú nội bộ.</li>}</ul><form class="crm-note-inline" data-runtime-quote-note><label><span>Thêm internal note</span><textarea name="content" rows="3" required></textarea></label><button class="button button-outline" type="submit">Lưu ghi chú nội bộ</button></form></section>
      <section class="crm-section"><header class="crm-section-header"><div><h2>History</h2><p>Lịch sử thay đổi báo giá.</p></div></header>{quote.history.length ? <ActivityTimeline activities={quote.history} /> : <div class="crm-compact-empty"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i><span>Chưa có lịch sử bổ sung.</span></div>}</section>
    </div>
    <aside class="quote-admin-side"><section class="crm-side-section"><h2>Quản lý báo giá</h2><label><span>Status</span><select data-status-select>{runtime ? <><option value="RECEIVED" selected={databaseStatus === "RECEIVED"}>Đã tiếp nhận</option><option value="CONSULTING" selected={databaseStatus === "CONSULTING"}>Đang tư vấn</option><option value="QUOTE_SENT" selected={databaseStatus === "QUOTE_SENT"}>Đã gửi báo giá</option><option value="NEGOTIATING" selected={databaseStatus === "NEGOTIATING"}>Đang trao đổi</option><option value="COMPLETED" selected={databaseStatus === "COMPLETED"}>Hoàn tất</option><option value="CANCELLED" selected={databaseStatus === "CANCELLED"}>Đã hủy</option></> : Object.entries(quoteStatusLabels).map(([value, label]) => <option value={value} selected={value === quote.status}>{label}</option>)}</select></label><label><span>Assigned Sales</span><select data-assignment-select data-initial-assignment={assignedToId || ""}><option value="">Chưa phân công</option>{salesOptions.map((sales) => <option value={sales.id} selected={sales.id === assignedToId || sales.name === quote.sales}>{sales.name}</option>)}</select></label><button class="button button-primary" type="button" data-save-status>Lưu thay đổi</button></section><section class="crm-side-section"><h2>Thông tin</h2><dl class="crm-side-data"><div><dt>Created</dt><dd>{quote.created}</dd></div><div><dt>Updated</dt><dd>{quote.updated}</dd></div><div><dt>Lead</dt><dd>{quote.leadId ? <a href={`/admin/crm/leads/${quote.leadId}`}>{quote.leadId}</a> : "Chưa tạo"}</dd></div><div><dt>Sales</dt><dd>{quote.sales}</dd></div></dl></section></aside>
  </div>
</CrmShell>
