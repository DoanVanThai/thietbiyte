                <div class="admin-media-thumbnail">
                  <img src={media.src} alt="" width="96" height="72" loading="lazy" data-media-image data-media-src={media.src} />
                  <button type="button" class="admin-media-image-error" data-media-retry hidden aria-label="Thử tải lại ảnh"><i class="ph ph-arrow-clockwise" aria-hidden="true"></i><span>Tải lại ảnh</span></button>
