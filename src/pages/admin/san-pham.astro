          <fieldset class="admin-field"><legend>Chế độ giá</legend><div class="admin-price-options"><label><input type="radio" name="priceMode" value="show" checked={editorProduct.priceMode === "SHOW_PRICE"} /><span><strong>Hiển thị giá</strong><small>Giá công khai trên trang sản phẩm</small></span></label><label><input type="radio" name="priceMode" value="contact" checked={editorProduct.priceMode === "CONTACT"} /><span><strong>Liên hệ</strong><small>Khách hàng liên hệ để nhận thông tin</small></span></label><label><input type="radio" name="priceMode" value="quote" checked={editorProduct.priceMode === "REQUEST_QUOTE"} /><span><strong>Yêu cầu báo giá</strong><small>Mở form báo giá theo cấu hình</small></span></label></div></fieldset>
