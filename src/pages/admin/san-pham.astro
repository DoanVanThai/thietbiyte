                  <label><span>Chú thích trong báo giá</span><input type="text" value={media.quoteCaption || media.alt} data-media-quote-caption /></label>
                  <label><span>Đặt ảnh sau mục</span><select data-media-quote-after><option value="" selected={!media.quoteAfterText}>Cuối phần mô tả</option>{quotePlacementOptions.map((line) => <option value={line} selected={media.quoteAfterText === line}>{line.length > 90 ? `${line.slice(0, 87)}…` : line}</option>)}</select></label>
