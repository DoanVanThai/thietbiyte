---
import AdminLayout from "@/layouts/AdminLayout.astro";
import "@/styles/admin-products.css";
import { productDetailFromCms } from "@/lib/public-content";
import { productService } from "@/server/services/product-service";
import { buildProductQuoteDescription } from "@/server/services/sales-quote-document";
import { can } from "@/server/auth/permissions";
import type { CmsProduct } from "@/lib/content-repository";
import { ADMIN_IMAGE_ACCEPT } from "@/lib/admin-image-upload";

const canCreateProduct = can(Astro.locals.auth, "product.create");
const canEditProduct = can(Astro.locals.auth, "product.edit");
const canDeleteProduct = can(Astro.locals.auth, "product.delete");
const canPublishProduct = can(Astro.locals.auth, "product.publish");
const canCreateQuote = can(Astro.locals.auth, "quote.edit");

const requestedPage = Math.max(1, Number(Astro.url.searchParams.get("page")) || 1);
const priceModeParam = Astro.url.searchParams.get("price");
const filters = {
  search: Astro.url.searchParams.get("q") || undefined,
  category: Astro.url.searchParams.get("category") || undefined,
  brand: Astro.url.searchParams.get("brand") || undefined,
  specialty: Astro.url.searchParams.get("specialty") || undefined,
  group: (Astro.url.searchParams.get("group") || undefined) as "medical" | "veterinary" | undefined,
  status: (Astro.url.searchParams.get("status") || undefined) as "published" | "draft" | "archived" | undefined,
  priceMode: priceModeParam === "Hiển thị giá" ? "SHOW_PRICE" as const : priceModeParam === "Yêu cầu báo giá" ? "REQUEST_QUOTE" as const : priceModeParam === "Liên hệ" ? "CONTACT" as const : undefined,
  featured: Astro.url.searchParams.get("featured") === "1",
};
const [{ products: catalogProducts, pagination }, filterOptions] = await Promise.all([
  productService.listAdminPage(requestedPage, 50, filters),
  productService.getAdminFilterOptions(),
]);
const { categories, brands, specialties } = filterOptions;
const statusFor = (status: string) => status === "published" ? ["Đã xuất bản", "published"] : status === "archived" ? ["Lưu trữ", "archived"] : ["Bản nháp", "draft"];
const priceModeFor = (mode: string) => mode === "SHOW_PRICE" ? "Hiển thị giá" : mode === "REQUEST_QUOTE" ? "Yêu cầu báo giá" : "Liên hệ";
const formatVnd = (value?: number) => typeof value === "number" ? `${new Intl.NumberFormat("vi-VN").format(value)} ₫` : "Chưa nhập giá";
const requestedId = Astro.url.searchParams.get("id");
const editorActive = Astro.url.searchParams.get("view") === "editor";
const isCreating = requestedId === "new";
const requestedProduct = editorActive && requestedId && requestedId !== "new" ? await productService.getAdminProduct(requestedId) : null;
const blankProduct: CmsProduct = {
  id: "new", slug: "", sku: "", name: "", model: "", group: "medical",
  category: categories[0] || "", categorySlug: "", brand: brands[0] || "", brandSlug: "",
  origin: "", warranty: "", description: "", priceBand: "", priceMode: "CONTACT",
  featured: 0, availability: "contact", image: "/images/project-handover-placeholder.webp", imagePosition: "center",
  specialties: [], specialtySlugs: [], applications: [], applicationSlugs: [], specs: [],
  publishStatus: "draft", createdOrder: Math.floor(Date.now() / 1000),
  detail: { gallery: [], features: [], configurations: [], specificationGroups: [], documents: [] },
};
const editorProduct = isCreating ? blankProduct : requestedProduct || catalogProducts[0] || blankProduct;
const serializedProducts = isCreating
  ? [blankProduct, ...catalogProducts]
  : requestedProduct && !catalogProducts.some((product) => product.id === requestedProduct.id)
  ? [requestedProduct, ...catalogProducts]
  : catalogProducts;
const pageHref = (page: number) => { const url = new URL(Astro.url); url.searchParams.set("page", String(page)); return `${url.pathname}${url.search}`; };
const resolvedEditorDetail = productDetailFromCms(editorProduct);
const editorDetail = (isCreating ? { ...resolvedEditorDetail, overview: [], gallery: [], features: [], configurations: [], specificationGroups: [], applications: [], documents: [], warranty: undefined, seo: undefined } : resolvedEditorDetail) as ReturnType<typeof productDetailFromCms> & {
  configurations: Array<{ title: string; items: Array<{ name: string; detail?: string; quantity?: number; imageUrl?: string }> }>;
};
const editorSeoTitle = editorProduct.detail?.seo?.title || (isCreating ? "" : `${editorProduct.name} | THIÊN LỘC GROUP`);
const editorSeoDescription = editorProduct.detail?.seo?.description || (isCreating ? "" : `Thông tin, cấu hình và tư vấn ${editorProduct.name} tại THIÊN LỘC GROUP.`);
const quotePlacementOptions = [...new Set(buildProductQuoteDescription(editorProduct).split("\n").map((line) => line.trim()).filter(Boolean))];

const editorSections = [
  ["info", "Thông tin cơ bản"], ["classification", "Phân loại"], ["media", "Hình ảnh"], ["pricing", "Giá bán"],
  ["description", "Mô tả"], ["features", "Tính năng"], ["configuration", "Cấu hình"], ["specifications", "Thông số kỹ thuật"],
  ["applications", "Ứng dụng"], ["documents", "Tài liệu"], ["warranty", "Bảo hành"], ["seo", "SEO"],
] as const;
---

<AdminLayout title="Quản lý sản phẩm | THIÊN LỘC GROUP Admin" description="Quản lý danh mục và nội dung sản phẩm." section="Sản phẩm">
  <script id="admin-product-data" type="application/json" is:inline set:html={JSON.stringify(serializedProducts)} />

  <section class="admin-products-view" data-products-list-view aria-labelledby="products-title">
    <header class="admin-page-header">
      <div><nav aria-label="Đường dẫn"><a href="/admin">Quản trị</a><i class="ph ph-caret-right" aria-hidden="true"></i><span>Sản phẩm</span></nav><h1 id="products-title">Sản phẩm</h1><p>Quản lý thông tin hiển thị trên website và dữ liệu phục vụ báo giá.</p></div>
      {canCreateProduct && <div class="admin-page-actions">
        <a class="button button-outline" href="/api/admin/products/import-template"><i class="ph ph-download-simple" aria-hidden="true"></i>Tải JSON mẫu</a>
        <button class="button button-outline" type="button" data-open-product-import><i class="ph ph-file-arrow-up" aria-hidden="true"></i>Nhập JSON</button>
        <a class="button button-primary" href="/admin/san-pham?view=editor&id=new" data-open-new-product><i class="ph ph-plus" aria-hidden="true"></i>Thêm sản phẩm</a>
      </div>}
    </header>

    <section class="admin-filter-region" aria-labelledby="filters-title">
      <h2 id="filters-title" class="sr-only">Lọc sản phẩm</h2>
      <div class="admin-filter-primary">
        <form class="admin-product-search-form" action="/admin/san-pham" method="get" role="search" data-product-search-form>
          <label class="admin-search-field" for="admin-product-search"><i class="ph ph-magnifying-glass" aria-hidden="true"></i><span class="sr-only">Tìm sản phẩm</span><input id="admin-product-search" name="q" type="search" placeholder="Tên sản phẩm, model, SKU..." autocomplete="off" data-admin-search value={filters.search || ""} /></label>
        </form>
        <select aria-label="Danh mục" data-filter="category"><option value="all">Tất cả danh mục</option>{categories.map((category) => <option value={category} selected={filters.category === category}>{category}</option>)}</select>
        <select aria-label="Thương hiệu" data-filter="brand"><option value="all">Tất cả thương hiệu</option>{brands.map((brand) => <option value={brand} selected={filters.brand === brand}>{brand}</option>)}</select>
        <button class="button button-outline admin-more-filters" type="button" data-more-filters aria-expanded="false" aria-controls="admin-secondary-filters"><i class="ph ph-funnel" aria-hidden="true"></i>Bộ lọc khác<span data-filter-count hidden>0</span></button>
      </div>
      <div class="admin-filter-secondary" id="admin-secondary-filters" data-secondary-filters hidden>
        <select aria-label="Chuyên khoa" data-filter="specialty"><option value="all">Tất cả chuyên khoa</option>{specialties.map((specialty) => <option value={specialty} selected={filters.specialty === specialty}>{specialty}</option>)}</select>
        <select aria-label="Nhóm sản phẩm" data-filter="group"><option value="all">Y tế & Thú y</option><option value="medical" selected={filters.group === "medical"}>Y tế</option><option value="veterinary" selected={filters.group === "veterinary"}>Thú y</option></select>
        <select aria-label="Trạng thái" data-filter="status"><option value="all">Tất cả trạng thái</option><option value="published" selected={filters.status === "published"}>Đã xuất bản</option><option value="draft" selected={filters.status === "draft"}>Bản nháp</option><option value="archived" selected={filters.status === "archived"}>Lưu trữ</option></select>
        <select aria-label="Chế độ giá" data-filter="price"><option value="all">Tất cả chế độ giá</option><option value="Hiển thị giá" selected={priceModeParam === "Hiển thị giá"}>Hiển thị giá</option><option value="Liên hệ" selected={priceModeParam === "Liên hệ"}>Liên hệ</option><option value="Yêu cầu báo giá" selected={priceModeParam === "Yêu cầu báo giá"}>Yêu cầu báo giá</option></select>
        <label class="admin-checkbox"><input type="checkbox" data-filter-featured checked={filters.featured} /><span>Chỉ sản phẩm nổi bật</span></label>
        <button class="admin-clear-filters" type="button" data-clear-filters>Đặt lại</button>
      </div>
    </section>

    <div class="admin-list-meta"><p><strong data-result-count>{catalogProducts.length}</strong> sản phẩm trên trang · {pagination.total} tổng cộng</p><span data-filter-summary>Hiển thị trang {pagination.page}/{pagination.totalPages}</span></div>

    <div class="admin-bulk-bar" data-bulk-bar hidden>
      <span><strong data-selected-count>0</strong> sản phẩm đã chọn</span>
      <div>
        {canPublishProduct && <button type="button" data-bulk-action="published" data-bulk-label="Xuất bản"><i class="ph ph-check-circle" aria-hidden="true"></i>Xuất bản</button>}
        {canPublishProduct && <button type="button" data-bulk-action="unpublish" data-bulk-label="Gỡ xuất bản"><i class="ph ph-eye-slash" aria-hidden="true"></i>Gỡ xuất bản</button>}
        {canEditProduct && <button type="button" data-bulk-category><i class="ph ph-folder" aria-hidden="true"></i>Chuyển danh mục</button>}
        {canEditProduct && <button type="button" data-bulk-action="featured" data-bulk-label="Đặt nổi bật"><i class="ph ph-star" aria-hidden="true"></i>Nổi bật</button>}
        {canEditProduct && <button type="button" data-bulk-action="archived" data-bulk-label="Lưu trữ"><i class="ph ph-archive" aria-hidden="true"></i>Lưu trữ</button>}
        {canDeleteProduct && <button class="admin-bulk-danger" type="button" data-bulk-delete><i class="ph ph-trash" aria-hidden="true"></i>Xóa</button>}
      </div>
      <button class="admin-bulk-clear" type="button" data-clear-selection aria-label="Bỏ chọn tất cả"><i class="ph ph-x" aria-hidden="true"></i></button>
    </div>

    <div class="admin-products-table-wrap">
      <table class="admin-products-table" hidden={catalogProducts.length === 0}>
        <caption class="sr-only">Danh sách sản phẩm</caption>
        <thead><tr>
          <th class="admin-select-column" scope="col"><input type="checkbox" data-select-all aria-label="Chọn tất cả sản phẩm đang hiển thị" /></th>
          <th scope="col">Sản phẩm</th><th scope="col">Model & thương hiệu</th><th scope="col">Phân loại</th><th scope="col">Giá</th><th scope="col">Trạng thái</th><th scope="col">Cập nhật</th><th scope="col"><span class="sr-only">Thao tác</span></th>
        </tr></thead>
        <tbody data-product-table-body>
          {catalogProducts.map((product, index) => {
            const [statusLabel, statusKey] = statusFor(product.publishStatus);
            const priceMode = priceModeFor(product.priceMode);
            const updated = index < 2 ? "Hôm nay" : index < 5 ? "Hôm qua" : `${index + 1}/08/2026`;
            return (
              <tr data-product-row data-id={product.id} data-search={`${product.name} ${product.model} ${product.sku} ${product.id}`.toLocaleLowerCase("vi")} data-category={product.category} data-brand={product.brand} data-specialties={product.specialties.join("|")} data-group={product.group} data-status={statusKey} data-price={priceMode} data-featured={product.featured >= 9 ? "true" : "false"}>
                <td class="admin-select-column"><input type="checkbox" data-row-select aria-label={`Chọn ${product.name}`} /></td>
                <td class="admin-product-name"><div class="admin-product-identity"><img src={product.image} alt="" width="56" height="46" loading="lazy" /><a href={canEditProduct ? `/admin/san-pham?view=editor&id=${product.id}` : `/san-pham/${product.slug}`}><strong>{product.name}</strong><span>SKU: {product.sku || product.id.toUpperCase()}</span></a></div></td>
                <td class="admin-product-details"><strong>{product.model.replace(" (minh họa)", "") || "Chưa cập nhật model"}</strong><span>{product.brand || "Chưa cập nhật thương hiệu"}</span></td>
                <td class="admin-product-classification"><strong>{product.category || "Chưa phân loại"}</strong><span class={`admin-group-tag group-${product.group}`}>{product.group === "medical" ? "Y tế" : "Thú y"}</span></td>
                <td><span class="admin-price-mode">{formatVnd(product.priceVnd)}</span><small>{priceMode}</small></td>
                <td><span class={`admin-product-status status-${statusKey}`}><i aria-hidden="true"></i>{statusLabel}</span></td>
                <td><time datetime={`2026-08-${String(Math.max(1, 13 - index)).padStart(2, "0")}`}>{updated}</time></td>
                <td>{(canEditProduct || canCreateProduct) && <button class="admin-row-menu" type="button" data-row-menu aria-label={`Thao tác với ${product.name}`} aria-expanded="false"><i class="ph ph-dots-three-vertical" aria-hidden="true"></i></button>}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <div class="admin-table-empty" data-table-empty hidden={catalogProducts.length > 0}><i class="ph ph-magnifying-glass" aria-hidden="true"></i><h2>Không tìm thấy sản phẩm</h2><p>Thử thay đổi từ khóa hoặc đặt lại bộ lọc.</p><button class="button button-outline" type="button" data-clear-filters>Đặt lại bộ lọc</button></div>
    </div>

    <footer class="admin-pagination">
      <span>{(pagination.page - 1) * pagination.pageSize + (catalogProducts.length ? 1 : 0)} đến {(pagination.page - 1) * pagination.pageSize + catalogProducts.length} / {pagination.total}</span>
      <nav aria-label="Phân trang">
        {pagination.page > 1 ? <a class="button button-outline button-sm" href={pageHref(pagination.page - 1)} aria-label="Trang trước" data-astro-prefetch="tap"><i class="ph ph-caret-left" aria-hidden="true"></i></a> : <button type="button" disabled aria-label="Trang trước"><i class="ph ph-caret-left" aria-hidden="true"></i></button>}
        <span aria-current="page">{pagination.page}</span>
        {pagination.page < pagination.totalPages ? <a class="button button-outline button-sm" href={pageHref(pagination.page + 1)} aria-label="Trang sau" data-astro-prefetch="tap"><i class="ph ph-caret-right" aria-hidden="true"></i></a> : <button type="button" disabled aria-label="Trang sau"><i class="ph ph-caret-right" aria-hidden="true"></i></button>}
      </nav>
    </footer>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
      const search = document.querySelector("[data-admin-search]");
      const form = document.querySelector("[data-product-search-form]");
      if (!(search instanceof HTMLInputElement) || !(form instanceof HTMLFormElement) || search.dataset.autoSearchBound === "true") return;
      search.dataset.autoSearchBound = "true";

      let timer = 0;
      let composing = false;
      const normalize = (value) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLocaleLowerCase("vi").trim();
      const filterVisibleRows = () => {
        const query = normalize(search.value);
        const filters = [...document.querySelectorAll("select[data-filter]")];
        const activeSelects = filters.filter((filter) => filter.value !== "all");
        const featured = document.querySelector("[data-filter-featured]");
        let visible = 0;
        document.querySelectorAll("[data-product-row]").forEach((row) => {
          const matchesSearch = !query || normalize(row.dataset.search || "").includes(query);
          const matchesFilters = activeSelects.every((filter) => {
            const key = filter.dataset.filter || "";
            if (key === "specialty") return (row.dataset.specialties || "").split("|").includes(filter.value);
            return row.dataset[key] === filter.value;
          });
          const matchesFeatured = !(featured instanceof HTMLInputElement && featured.checked) || row.dataset.featured === "true";
          row.hidden = !(matchesSearch && matchesFilters && matchesFeatured);
          if (!row.hidden) visible += 1;
        });
        const count = document.querySelector("[data-result-count]");
        const table = document.querySelector(".admin-products-table");
        const empty = document.querySelector("[data-table-empty]");
        if (count) count.textContent = String(visible);
        if (table) table.hidden = visible === 0;
        if (empty) empty.hidden = visible > 0;
      };
      const loadServerResults = () => {
        const url = new URL(window.location.href);
        const query = search.value.trim();
        if (query) url.searchParams.set("q", query);
        else url.searchParams.delete("q");
        url.searchParams.set("page", "1");
        const target = `${url.pathname}${url.search}`;
        if (target !== `${window.location.pathname}${window.location.search}`) window.location.replace(target);
      };
      const scheduleSearch = () => {
        filterVisibleRows();
        window.clearTimeout(timer);
        if (!composing) timer = window.setTimeout(loadServerResults, 280);
      };

      search.addEventListener("compositionstart", () => { composing = true; window.clearTimeout(timer); });
      search.addEventListener("compositionend", () => { composing = false; scheduleSearch(); });
      search.addEventListener("input", scheduleSearch);
      form.addEventListener("submit", (event) => { event.preventDefault(); window.clearTimeout(timer); filterVisibleRows(); loadServerResults(); });
    })();
  </script>

  <section class="admin-editor-view" data-product-editor hidden aria-labelledby="editor-title">
    <header class="admin-editor-header">
      <div class="admin-editor-title"><a href="/admin/san-pham" data-close-editor aria-label="Quay lại danh sách"><i class="ph ph-arrow-left" aria-hidden="true"></i></a><div><span data-editor-kicker>{isCreating ? "Sản phẩm mới" : "Chỉnh sửa sản phẩm"}</span><h2 id="editor-title" data-editor-heading>{isCreating ? "Sản phẩm chưa đặt tên" : editorProduct.name}</h2><p><span class={`admin-product-status status-${statusFor(editorProduct.publishStatus)[1]}`}><i aria-hidden="true"></i>{statusFor(editorProduct.publishStatus)[0]}</span><span data-editor-id>{isCreating ? "BẢN NHÁP MỚI" : editorProduct.id.toUpperCase()}</span></p></div></div>
      <div class="admin-editor-actions">
        <div class="admin-editor-secondary-actions" role="group" aria-label="Công cụ sản phẩm">
          {canCreateQuote && !isCreating && <a class="button button-outline" href={`/admin/bao-gia?product=${encodeURIComponent(editorProduct.id)}`}><i class="ph ph-file-pdf" aria-hidden="true"></i>Báo giá PDF</a>}
          <a class="button button-outline" href={isCreating ? undefined : `/san-pham/${editorProduct.slug}`} target="_blank" rel="noopener noreferrer" data-preview-link aria-disabled={isCreating ? "true" : undefined}><i class="ph ph-eye" aria-hidden="true"></i>Xem trước</a>
        </div>
        <div class="admin-editor-primary-actions" role="group" aria-label="Lưu sản phẩm">
          <span class:list={["admin-save-state", isCreating && "is-dirty"]} data-save-state><i class={`ph ${isCreating ? "ph-warning-circle" : "ph-cloud-check"}`} aria-hidden="true"></i>{isCreating ? "Chưa lưu" : "Đã lưu"}</span>
          <button class="button button-outline" type="button" data-save-draft>Lưu nháp</button>
          {canPublishProduct && <button class="button button-primary" type="button" data-save-publish>Lưu & xuất bản</button>}
        </div>
      </div>
    </header>

    <div class="admin-editor-layout">
      <nav class="admin-editor-nav" aria-label="Các phần của sản phẩm">
        {editorSections.map(([id, label], index) => <a href={`#editor-${id}`} aria-current={index === 0 ? "location" : undefined} data-editor-nav>{label}</a>)}
      </nav>

      <form class="admin-product-form" data-product-form data-product-id={requestedId === "new" ? "" : editorProduct.id} novalidate>
        <section class="admin-editor-section" id="editor-info" aria-labelledby="editor-info-title">
          <header><div><h2 id="editor-info-title">Thông tin cơ bản</h2><p>Thông tin nhận diện và trạng thái vận hành của sản phẩm.</p></div></header>
          <div class="admin-form-grid">
            <div class="admin-field span-2"><label for="product-name">Tên sản phẩm</label><input id="product-name" name="name" type="text" value={editorProduct.name} required data-editor-name aria-describedby="product-name-error" aria-errormessage="product-name-error" /><p id="product-name-error" data-field-error aria-live="polite"></p></div>
            <div class="admin-field span-2"><label for="product-slug">Slug</label><div class="admin-input-prefix admin-generated-field"><span>/san-pham/</span><input id="product-slug" name="slug" type="text" value={editorProduct.slug} placeholder="tự-tạo-từ-tên-sản-phẩm" required data-editor-slug aria-describedby="product-slug-help product-slug-error" aria-errormessage="product-slug-error" /><button type="button" data-generate-slug title="Tạo lại slug từ tên sản phẩm"><i class="ph ph-arrows-clockwise" aria-hidden="true"></i><span>Tạo lại</span></button></div><small class="admin-field-help" id="product-slug-help">Tự động tạo từ tên sản phẩm; bạn vẫn có thể chỉnh sửa.</small><p id="product-slug-error" data-field-error aria-live="polite"></p></div>
            <div class="admin-field"><label for="product-sku">SKU</label><div class="admin-input-action admin-generated-field"><input id="product-sku" name="sku" type="text" value={isCreating ? "" : editorProduct.sku} placeholder="TL-2026-XXXXXX" required data-editor-sku aria-describedby="product-sku-help product-sku-error" aria-errormessage="product-sku-error" /><button type="button" data-generate-sku title="Tạo mã SKU ngẫu nhiên"><i class="ph ph-dice-five" aria-hidden="true"></i><span>Tạo mã</span></button></div><small class="admin-field-help" id="product-sku-help">Mã được tạo ngẫu nhiên và có thể tạo lại.</small><p id="product-sku-error" data-field-error aria-live="polite"></p></div>
            <div class="admin-field"><label for="product-model">Model</label><input id="product-model" name="model" type="text" value={editorProduct.model} required data-editor-model aria-describedby="product-model-error" aria-errormessage="product-model-error" /><p id="product-model-error" data-field-error aria-live="polite"></p></div>
            <div class="admin-field"><label for="product-brand">Thương hiệu</label><select id="product-brand" name="brand" data-editor-brand>{brands.map((brand) => <option selected={brand === editorProduct.brand}>{brand}</option>)}</select></div>
            <div class="admin-field"><label for="product-category">Danh mục</label><select id="product-category" name="category" data-editor-category>{categories.map((category) => <option selected={category === editorProduct.category}>{category}</option>)}</select></div>
            <div class="admin-field"><label for="product-origin">Xuất xứ</label><input id="product-origin" name="origin" type="text" value={editorProduct.origin} data-editor-origin /></div>
