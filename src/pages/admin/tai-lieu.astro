---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { can } from "@/server/auth/permissions";
import { listDocuments } from "@/server/repositories/operations-repository";
import { productService } from "@/server/services/product-service";
import "@/styles/admin-operations.css";

const [documents, products] = await Promise.all([Promise.resolve(listDocuments()), productService.listAdminCatalog()]);
const canManage = can(Astro.locals.auth, "document.manage");
const typeLabel = { catalogue: "Catalogue", datasheet: "Thông số kỹ thuật", manual: "Hướng dẫn", certificate: "Chứng nhận", warranty: "Bảo hành", other: "Tài liệu khác" } as const;
const accessLabel = { public: "Công khai", registered: "Khách hàng", staff: "Nhân viên", admin: "Quản trị" } as const;
const formatSize = (size: number) => size < 1024 * 1024 ? `${Math.max(1, Math.round(size / 1024))} KB` : `${(size / 1024 / 1024).toLocaleString("vi-VN", { maximumFractionDigits: 1 })} MB`;
const formatDate = (value: string) => new Intl.DateTimeFormat("vi-VN", { dateStyle: "short" }).format(new Date(`${value.replace(" ", "T")}Z`));
---
<AdminLayout title="Tài liệu | Thiên Lộc Admin" description="Quản lý tài liệu sản phẩm và quyền truy cập." section="Tài liệu">
  <section class="ops-page" data-ops-module="documents" data-can-manage={String(canManage)} aria-labelledby="ops-title">
    <script id="ops-documents-data" type="application/json" is:inline set:html={JSON.stringify(documents)} />
    <header class="admin-page-header ops-page-header"><div><span class="ops-eyebrow">Vận hành · Tài liệu</span><h1 id="ops-title">Thư viện tài liệu</h1><p>Quản lý catalogue, hướng dẫn và chứng nhận gắn với sản phẩm.</p></div>{canManage && <button class="admin-button primary" type="button" data-document-new><i class="ph ph-upload-simple" aria-hidden="true"></i>Tải tài liệu</button>}</header>
    <div class="ops-summary ops-summary-static"><div><span>Tổng tài liệu</span><strong>{documents.length}</strong></div><div><span>Công khai</span><strong>{documents.filter((item) => item.access === "public").length}</strong></div><div><span>Có sản phẩm</span><strong>{documents.filter((item) => item.productId).length}</strong></div><div><span>Dung lượng</span><strong>{formatSize(documents.reduce((sum, item) => sum + item.fileSize, 0))}</strong></div></div>
    <div class="ops-toolbar ops-document-toolbar"><label class="ops-search"><span class="sr-only">Tìm tài liệu</span><i class="ph ph-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Tìm tên tài liệu hoặc sản phẩm…" data-ops-search /></label><label><span>Loại</span><select data-ops-type><option value="all">Tất cả loại</option>{Object.entries(typeLabel).map(([value,label]) => <option value={value}>{label}</option>)}</select></label><label><span>Quyền truy cập</span><select data-ops-access><option value="all">Tất cả quyền</option>{Object.entries(accessLabel).map(([value,label]) => <option value={value}>{label}</option>)}</select></label><button class="icon-button subtle" type="button" data-ops-reset aria-label="Đặt lại bộ lọc"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i></button></div>
    <div class="admin-table-wrap ops-table-wrap"><table class="admin-table ops-table document-ops-table"><caption class="sr-only">Danh sách tài liệu</caption><thead><tr><th>Tài liệu</th><th>Loại</th><th>Sản phẩm</th><th>Quyền</th><th>Dung lượng</th><th>Cập nhật</th><th><span class="sr-only">Thao tác</span></th></tr></thead><tbody data-ops-rows>
      {documents.map((document) => <tr data-ops-row data-id={document.id} data-search={`${document.name} ${document.productName}`.toLocaleLowerCase("vi")} data-type={document.type} data-access={document.access}><td><div class="ops-file-cell"><span class="ops-file-icon"><i class="ph ph-file-pdf" aria-hidden="true"></i></span><div><a class="ops-title-button" href={document.url} target="_blank">{document.name}</a><small>Phiên bản {document.version} · {document.originalName}</small></div></div></td><td>{typeLabel[document.type]}</td><td>{document.productName || "Dùng chung"}</td><td><span class={`ops-access ${document.access}`}><i class={`ph ${document.access === "public" ? "ph-globe" : "ph-lock-key"}`} aria-hidden="true"></i>{accessLabel[document.access]}</span></td><td class="numeric">{formatSize(document.fileSize)}</td><td class="numeric">{formatDate(document.updatedAt)}</td><td>{canManage && <div class="ops-row-actions"><button class="icon-button subtle" type="button" data-document-edit={document.id} aria-label={`Sửa ${document.name}`}><i class="ph ph-pencil-simple" aria-hidden="true"></i></button><button class="icon-button danger" type="button" data-document-delete={document.id} aria-label={`Xóa ${document.name}`}><i class="ph ph-trash" aria-hidden="true"></i></button></div>}</td></tr>)}
    </tbody></table><div class="ops-empty" data-ops-empty hidden={documents.length > 0}><i class="ph ph-files" aria-hidden="true"></i><strong>Chưa có tài liệu</strong><span>Tải catalogue hoặc tài liệu kỹ thuật để liên kết với sản phẩm.</span></div></div><footer class="ops-list-footer"><span>Đang hiển thị <strong data-ops-visible>{documents.length}</strong> / {documents.length} tài liệu</span></footer>
    <dialog class="ops-dialog ops-compact-dialog" data-document-dialog aria-labelledby="document-dialog-title"><form class="ops-dialog-form" data-document-form><header><div><span class="ops-eyebrow">Thư viện</span><h2 id="document-dialog-title" data-document-dialog-title>Tải tài liệu</h2></div><button class="icon-button subtle" type="button" data-dialog-close aria-label="Đóng"><i class="ph ph-x" aria-hidden="true"></i></button></header><div class="ops-dialog-body"><input type="hidden" name="id" /><input type="hidden" name="url" /><input type="hidden" name="originalName" /><input type="hidden" name="mimeType" /><input type="hidden" name="fileSize" value="0" />
      <label class="ops-upload-zone" data-document-file-zone><input type="file" name="file" accept=".pdf,.doc,.docx" /><i class="ph ph-cloud-arrow-up" aria-hidden="true"></i><strong>Chọn PDF, DOC hoặc DOCX</strong><span>Tối đa 15 MB. File được lưu vào kho dùng chung.</span></label>
      <label class="ops-field"><span>Tên hiển thị <b>*</b></span><input name="name" required maxlength="180" /></label><div class="ops-two-cols"><label class="ops-field"><span>Loại tài liệu</span><select name="type">{Object.entries(typeLabel).map(([value,label]) => <option value={value}>{label}</option>)}</select></label><label class="ops-field"><span>Quyền truy cập</span><select name="access">{Object.entries(accessLabel).map(([value,label]) => <option value={value}>{label}</option>)}</select></label><label class="ops-field"><span>Sản phẩm liên kết</span><select name="productId"><option value="">Dùng chung, không gắn sản phẩm</option>{products.map((product) => <option value={product.id} data-product-name={product.name}>{product.name} · {product.model}</option>)}</select></label><label class="ops-field"><span>Phiên bản</span><input name="version" value="1.0" maxlength="30" /></label></div>
    </div><footer><p data-ops-feedback aria-live="polite"></p><button class="admin-button secondary" type="button" data-dialog-close>Hủy</button><button class="admin-button primary" type="submit"><i class="ph ph-floppy-disk" aria-hidden="true"></i><span data-submit-label>Lưu tài liệu</span></button></footer></form></dialog>
  </section><script>import "@/scripts/admin-operations";</script>
</AdminLayout>

