---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSettings } from "@/lib/content-repository";
import { buildProductQuoteDescription } from "@/server/services/sales-quote-document";
import { productService } from "@/server/services/product-service";
import "@/styles/admin-quote-pdf.css";

const products = await productService.listAdminCatalog();
const requestedProductId = Astro.url.searchParams.get("product");
const selectedProduct = products.find((product) => product.id === requestedProductId) || products[0];
const settings = getSettings();
const now = new Date();
const quoteDate = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Ho_Chi_Minh", year: "numeric", month: "2-digit", day: "2-digit" }).format(now);
const quoteNumber = `${String(now.getTime()).slice(-4)}/BG/${now.getFullYear()}`;
const productSources = products.map((product) => {
  const mediaImages = (product.detail?.gallery || []).filter((media) => media.type === "image" && media.quoteEnabled && media.src).map((media) => ({
    url: media.src,
    caption: media.quoteCaption || media.alt || "Ảnh minh họa",
    afterText: media.quoteAfterText || "",
  }));
  const configurationImages = (product.detail?.configurations || []).flatMap((group) => group.items
    .filter((item) => item.imageUrl)
    .map((item) => ({ url: item.imageUrl!, caption: item.name, afterText: `- ${item.name}${item.detail ? `: ${item.detail}` : ""}` })));
  const images = [...new Map([...mediaImages, ...configurationImages].map((image) => [`${image.url}\u0000${image.afterText}`, image])).values()];
  return { id: product.id, name: product.name, sku: product.sku, model: product.model, brand: product.brand, origin: product.origin, manufacturingYear: product.manufacturingYear, warranty: product.warranty, price: product.priceVnd || 0, description: buildProductQuoteDescription(product), images };
});
---

<AdminLayout title="Tạo báo giá PDF & Word | Thiên Lộc Admin" description="Tạo báo giá thiết bị từ dữ liệu sản phẩm và xuất PDF hoặc Word." section="Báo giá PDF">
  <script id="quote-product-data" type="application/json" is:inline set:html={JSON.stringify(productSources)} />
  <section class="quote-builder" data-quote-builder aria-labelledby="quote-builder-title">
    <header class="admin-page-header">
      <div>
        <nav aria-label="Đường dẫn"><a href="/admin">Quản trị</a><i class="ph ph-caret-right" aria-hidden="true"></i><span>Báo giá PDF</span></nav>
        <h1 id="quote-builder-title">Tạo báo giá thiết bị</h1>
        <p>Thông tin kỹ thuật và giá được lấy từ sản phẩm. Bạn có thể chỉnh lại trước khi tải PDF hoặc Word gửi khách hàng.</p>
      </div>
      <div class="quote-page-actions">
        <a class="button button-outline" href="/admin/bao-gia"><i class="ph ph-plus" aria-hidden="true"></i>Báo giá mới</a>
        <button class="button button-outline" type="button" data-toggle-saved-quotes aria-expanded="false"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i>Báo giá đã lưu</button>
        <a class="button button-outline" href="/admin/san-pham"><i class="ph ph-package" aria-hidden="true"></i>Quản lý sản phẩm</a>
      </div>
    </header>

    <section class="quote-saved-panel" data-saved-quotes-panel hidden aria-labelledby="saved-quotes-title">
      <header>
        <div><h2 id="saved-quotes-title">Báo giá đã lưu</h2><p>Mở lại bản trước đây để sửa tiếp. Mỗi lần cập nhật được lưu thành một phiên bản.</p></div>
        <button class="icon-action" type="button" data-close-saved-quotes aria-label="Đóng danh sách"><i class="ph ph-x" aria-hidden="true"></i></button>
      </header>
      <label class="quote-saved-search"><span class="sr-only">Tìm báo giá đã lưu</span><i class="ph ph-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Tìm theo số báo giá hoặc khách hàng..." data-saved-quote-search /></label>
      <div class="quote-saved-list" data-saved-quotes-list></div>
      <p class="quote-saved-empty" data-saved-quotes-empty hidden>Chưa có bản báo giá đã lưu.</p>
    </section>

    {selectedProduct ? (
      <form data-quote-form data-saved-quote-id="">
        <div class="quote-builder-main">
          <section class="quote-form-section" aria-labelledby="quote-document-title">
            <header><div><h2 id="quote-document-title">Thông tin báo giá</h2><p>Số báo giá có thể sửa hoặc để trống để dùng số gợi ý tự động.</p></div></header>
            <div class="quote-form-grid">
              <label><span>Số báo giá</span><input name="quoteNumber" value={quoteNumber} maxlength="80" placeholder="Tự động nếu để trống" data-default-quote-number={quoteNumber} /></label>
              <label><span>Ngày báo giá</span><input name="quoteDate" type="date" value={quoteDate} required /></label>
              <label><span>Địa điểm lập</span><input name="city" value="Hà Nội" required /></label>
              <label><span>Website</span><input name="website" value="thienlocgroup.com" /></label>
              <label class="span-2"><span>Dòng giới thiệu công ty</span><input name="companyTagline" value="Chuyên kinh doanh trang thiết bị y tế, hóa chất và vật tư tiêu hao." /></label>
              <label class="span-2"><span>Địa chỉ hiển thị đầu trang</span><textarea name="companyAddress" rows="2">{settings.address}</textarea></label>
            </div>
          </section>

          <section class="quote-form-section" aria-labelledby="quote-customer-title">
            <header><div><h2 id="quote-customer-title">Khách hàng</h2><p>Chỉ tên khách hàng hoặc đơn vị là bắt buộc.</p></div></header>
            <div class="quote-form-grid">
              <label><span>Người liên hệ</span><input name="customerName" placeholder="Nguyễn Văn An" required /></label>
              <label><span>Đơn vị</span><input name="customerOrganization" placeholder="Phòng khám / Bệnh viện" /></label>
              <label class="span-2"><span>Địa chỉ</span><input name="customerAddress" /></label>
              <label><span>Điện thoại</span><input name="customerPhone" inputmode="tel" /></label>
              <label><span>Email</span><input name="customerEmail" type="email" /></label>
              <label class="span-2"><span>Lời mở đầu</span><textarea name="introduction" rows="3" required>THIÊN LỘC GROUP xin hân hạnh gửi đến Quý khách bảng báo giá thiết bị với cấu hình chi tiết như sau:</textarea></label>
            </div>
          </section>

          <section class="quote-form-section quote-product-section" aria-labelledby="quote-product-title">
            <header><div><h2 id="quote-product-title">Sản phẩm và cấu hình</h2><p>Có thể thêm nhiều sản phẩm như mẫu báo giá tổng hợp.</p></div><button class="button button-outline button-sm" type="button" data-add-quote-item><i class="ph ph-plus" aria-hidden="true"></i>Thêm sản phẩm</button></header>
            <div class="quote-item-list" data-quote-items>
              <article class="quote-line-item" data-quote-item>
                <header><strong>Sản phẩm <span data-quote-item-number>1</span></strong><button type="button" data-remove-quote-item hidden><i class="ph ph-trash" aria-hidden="true"></i>Xóa</button></header>
                <div class="quote-form-grid">
                  <label class="span-2"><span>Sản phẩm</span><span class="quote-product-combobox" data-quote-product-combobox>
                    <input type="search" value={`${selectedProduct.name} · ${selectedProduct.model}`} autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" placeholder="Tìm theo tên, model hoặc mã sản phẩm..." data-quote-product-search />
                    <input type="hidden" name="productId" value={selectedProduct.id} data-quote-product />
                    <div class="quote-product-options" role="listbox" data-quote-product-options hidden></div>
                    <p class="quote-product-empty" role="status" data-quote-product-empty hidden>Không tìm thấy sản phẩm phù hợp.</p>
                  </span></label>
                  <label><span>Số lượng</span><input name="quantity" type="number" min="1" max="999" value="1" required /></label>
                  <label><span>Đơn giá (VNĐ)</span><input name="unitPrice" type="number" min="0" step="1000" value={selectedProduct.priceVnd || 0} required inputmode="numeric" /></label>
                  <div class="quote-inline-images span-2" data-quote-images></div>
                  <div class="span-2 quote-rich-field">
                    <div class="quote-rich-label"><span>Mô tả và cấu hình <b>· Bắt buộc</b></span><small>Chọn đoạn chữ rồi dùng thanh công cụ. Định dạng được giữ nguyên khi xuất PDF và Word.</small></div>
                    <div class="quote-rich-toolbar" role="toolbar" aria-label="Định dạng mô tả">
                      <button type="button" data-rich-command="bold" aria-label="In đậm" title="In đậm"><strong>B</strong></button>
                      <button type="button" data-rich-command="underline" aria-label="Gạch chân" title="Gạch chân"><span class="quote-toolbar-underline">U</span></button>
                      <button type="button" data-rich-command="red" aria-label="Chữ màu đỏ" title="Chữ màu đỏ"><span class="quote-toolbar-red">A</span></button>
                      <span aria-hidden="true"></span>
                      <button type="button" data-rich-command="clear" aria-label="Xóa định dạng" title="Xóa định dạng"><i class="ph ph-eraser" aria-hidden="true"></i></button>
                    </div>
                    <div class="quote-rich-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Mô tả và cấu hình sản phẩm" data-quote-description-editor></div>
                    <textarea name="description" data-quote-description hidden>{buildProductQuoteDescription(selectedProduct)}</textarea>
                  </div>
                </div>
              </article>
            </div>
          </section>

          <section class="quote-form-section" aria-labelledby="quote-terms-title">
            <header><div><h2 id="quote-terms-title">Điều khoản thương mại</h2><p>Được trình bày sau tổng giá trị báo giá.</p></div></header>
            <div class="quote-form-grid">
              <label class="quote-check span-2"><input name="vatIncluded" type="checkbox" checked /><span>Giá đã bao gồm thuế GTGT</span></label>
              <label class="span-2"><span>Giao hàng</span><input name="delivery" value="Vận chuyển, lắp đặt tại nơi sử dụng; thời gian giao hàng từ 1 đến 8 tuần kể từ khi ký hợp đồng và nhận đặt cọc." /></label>
              <label class="span-2"><span>Thanh toán</span><input name="payment" value="Đặt cọc 50%; giá trị còn lại thanh toán sau khi hai bên ký biên bản bàn giao máy." /></label>
              <label class="span-2"><span>Hiệu lực</span><input name="validity" value="Có hiệu lực 30 ngày kể từ ngày phát hành." /></label>
              <label class="span-2"><span>Điều khoản bổ sung</span><textarea name="additionalTerms" rows="3" placeholder="Mỗi dòng là một điều khoản."></textarea></label>
            </div>
          </section>
        </div>

        <aside class="quote-builder-side">
          <section>
            <span class="quote-side-icon"><i class="ph ph-file-pdf" aria-hidden="true"></i></span>
            <h2>Báo giá sẵn sàng gửi khách</h2>
            <p>Khổ A4, có tổng tiền bằng số và bằng chữ, điều khoản, khu vực ký tên; hỗ trợ PDF và Word.</p>
            <dl>
              <div><dt>Công ty</dt><dd>{settings.company}</dd></div>
              <div><dt>Sản phẩm</dt><dd data-quote-product-summary>1 sản phẩm</dd></div>
              <div><dt>Định dạng</dt><dd>PDF · Word · A4</dd></div>
            </dl>
          </section>
          <p class="quote-builder-feedback" data-quote-feedback role="status" aria-live="polite"></p>
          <button class="button button-outline button-lg quote-save-button" type="button" data-save-quote>
            <i class="ph ph-floppy-disk" aria-hidden="true"></i>
            <span data-save-quote-label>Lưu bản báo giá</span>
          </button>
          <p class="quote-saved-current" data-saved-quote-current hidden></p>
          <div class="quote-export-actions">
            <button class="button button-primary button-lg" type="submit" value="pdf" data-quote-download data-export-format="pdf">
              <i class="ph ph-file-pdf" aria-hidden="true" data-quote-download-icon></i>
              <i class="ph ph-circle-notch quote-download-spinner" aria-hidden="true"></i>
              <span data-quote-download-label data-default-label="Tạo và tải PDF">Tạo và tải PDF</span>
            </button>
            <button class="button button-outline button-lg" type="submit" value="word" data-quote-download data-export-format="word">
              <i class="ph ph-file-doc" aria-hidden="true" data-quote-download-icon></i>
              <i class="ph ph-circle-notch quote-download-spinner" aria-hidden="true"></i>
              <span data-quote-download-label data-default-label="Tạo và tải Word">Tạo và tải Word</span>
            </button>
          </div>
          <small>Tệp chỉ được tạo sau khi dữ liệu hợp lệ. Hoạt động xuất báo giá được ghi vào Audit Log.</small>
        </aside>
      </form>
    ) : (
      <div class="quote-builder-empty"><i class="ph ph-package" aria-hidden="true"></i><h2>Chưa có sản phẩm</h2><p>Hãy tạo sản phẩm trước khi lập báo giá.</p><a class="button button-primary" href="/admin/san-pham?view=editor&id=new">Thêm sản phẩm</a></div>
    )}

    <dialog class="quote-file-name-dialog" data-quote-file-dialog aria-labelledby="quote-file-dialog-title">
      <form method="dialog" data-quote-file-form>
        <header>
          <span class="quote-file-dialog-icon"><i class="ph ph-file-arrow-down" aria-hidden="true"></i></span>
          <div><h2 id="quote-file-dialog-title" data-quote-file-dialog-title>Tên file xuất</h2><p>Kiểm tra hoặc sửa tên trước khi tải xuống.</p></div>
          <button class="icon-action" type="submit" value="cancel" formnovalidate aria-label="Đóng"><i class="ph ph-x" aria-hidden="true"></i></button>
        </header>
        <div class="quote-file-dialog-body">
          <label for="quote-export-file-name">Tên file</label>
          <div class="quote-file-name-control">
            <input id="quote-export-file-name" type="text" required maxlength="180" autocomplete="off" data-quote-file-name />
            <span data-quote-file-extension>.pdf</span>
          </div>
          <small>Đuôi file được giữ cố định theo định dạng bạn đã chọn.</small>
        </div>
        <footer>
          <button class="button button-outline" type="submit" value="cancel" formnovalidate>Hủy</button>
          <button class="button button-primary" type="submit" value="confirm"><i class="ph ph-download-simple" aria-hidden="true"></i><span data-quote-file-confirm>OK, tải file</span></button>
        </footer>
      </form>
    </dialog>
  </section>
  <script>import "@/scripts/admin-quote-pdf";</script>
</AdminLayout>
