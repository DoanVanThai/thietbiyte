---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { can } from "@/server/auth/permissions";
import { listMedia } from "@/server/repositories/operations-repository";
import "@/styles/admin-operations.css";
import { ADMIN_IMAGE_ACCEPT } from "@/lib/admin-image-upload";
const media = await listMedia();
const canManage = can(Astro.locals.auth, "document.manage");
const formatSize = (size: number) => size < 1024 * 1024 ? `${Math.max(1, Math.round(size / 1024))} KB` : `${(size / 1024 / 1024).toLocaleString("vi-VN", { maximumFractionDigits: 1 })} MB`;
---
<AdminLayout title="Thư viện media | Thiên Lộc Admin" description="Quản lý hình ảnh dùng chung trên website." section="Thư viện media">
  <section class="ops-page" data-ops-module="media" data-can-manage={String(canManage)} aria-labelledby="ops-title">
    <script id="ops-media-data" type="application/json" is:inline set:html={JSON.stringify(media)} />
    <header class="admin-page-header ops-page-header"><div><span class="ops-eyebrow">Vận hành · Media</span><h1 id="ops-title">Thư viện media</h1><p>Tải một lần, bổ sung alt và tái sử dụng trên sản phẩm, nội dung, báo giá. Hỗ trợ cả ảnh HEIC/HEIF trên điện thoại.</p></div>{canManage && <label class="admin-button primary ops-upload-button"><input type="file" accept={ADMIN_IMAGE_ACCEPT} multiple data-media-upload /><i class="ph ph-upload-simple" aria-hidden="true"></i>Tải ảnh</label>}</header>
    <div class="ops-media-bar"><label class="ops-search"><span class="sr-only">Tìm media</span><i class="ph ph-magnifying-glass" aria-hidden="true"></i><input type="search" placeholder="Tìm theo tên file hoặc mô tả alt…" data-ops-search /></label><label><span>Nguồn</span><select data-ops-source><option value="all">Tất cả nguồn</option><option value="upload">Đã tải lên</option><option value="public">Ảnh hệ thống</option></select></label><div class="view-toggle" role="group" aria-label="Kiểu hiển thị"><button type="button" aria-pressed="true" data-media-view="grid" aria-label="Dạng lưới"><i class="ph ph-squares-four" aria-hidden="true"></i></button><button type="button" aria-pressed="false" data-media-view="list" aria-label="Dạng danh sách"><i class="ph ph-list" aria-hidden="true"></i></button></div></div>
    <div class="ops-media-status"><span><strong data-ops-visible>{media.length}</strong> tài nguyên</span><span data-upload-progress aria-live="polite"></span></div>
    <div class="ops-media-grid" data-media-library data-view="grid" data-ops-rows>
      {media.map((item) => <article class="ops-media-item" data-ops-row data-id={item.id} data-search={`${item.name} ${item.alt}`.toLocaleLowerCase("vi")} data-source={item.source}><button type="button" class="ops-media-thumb" data-media-edit={item.id}><img src={item.url} alt={item.alt || ""} loading="lazy" /><span>{item.source === "upload" ? "Đã tải lên" : "Hệ thống"}</span><i class="ph ph-pencil-simple" aria-hidden="true"></i></button><div><strong title={item.name}>{item.name}</strong><span>{item.width && item.height ? `${item.width} × ${item.height} · ` : ""}{formatSize(item.fileSize)}</span><p class:list={[!item.alt && "is-warning"]}>{item.alt || "Chưa có mô tả thay thế"}</p></div></article>)}
    </div><div class="ops-empty" data-ops-empty hidden={media.length > 0}><i class="ph ph-image" aria-hidden="true"></i><strong>Không có ảnh phù hợp</strong><span>Thử đổi từ khóa hoặc tải ảnh mới.</span></div>
    <dialog class="ops-dialog media-editor-dialog" data-media-dialog aria-labelledby="media-dialog-title"><form class="ops-dialog-form" data-media-form><header><div><span class="ops-eyebrow">Chi tiết media</span><h2 id="media-dialog-title" data-media-dialog-title>Chỉnh sửa ảnh</h2></div><button class="icon-button subtle" type="button" data-dialog-close aria-label="Đóng"><i class="ph ph-x" aria-hidden="true"></i></button></header><div class="media-editor-body"><div class="media-editor-preview"><img src="/images/project-handover-placeholder.webp" alt="" data-media-preview /><dl><div><dt>Kích thước</dt><dd data-media-dimensions>—</dd></div><div><dt>Dung lượng</dt><dd data-media-size>—</dd></div><div><dt>Nguồn</dt><dd data-media-source>—</dd></div></dl></div><div class="media-editor-fields"><input type="hidden" name="id" /><input type="hidden" name="url" /><input type="hidden" name="mimeType" /><input type="hidden" name="fileSize" /><input type="hidden" name="width" /><input type="hidden" name="height" /><input type="hidden" name="source" /><label class="ops-field"><span>Tên file</span><input name="name" required maxlength="255" /></label><label class="ops-field"><span>Mô tả thay thế (alt)</span><textarea name="alt" rows="3" maxlength="240"></textarea><small>Mô tả ngắn nội dung ảnh cho người dùng trình đọc màn hình.</small></label><label class="ops-field"><span>Chú thích</span><textarea name="caption" rows="3" maxlength="500"></textarea></label><button class="admin-button secondary" type="button" data-copy-media-url><i class="ph ph-copy" aria-hidden="true"></i>Sao chép URL</button></div></div><footer><p data-ops-feedback aria-live="polite"></p><button class="admin-button danger" type="button" data-media-delete><i class="ph ph-trash" aria-hidden="true"></i>Xóa ảnh</button><span class="ops-footer-spacer"></span><button class="admin-button secondary" type="button" data-dialog-close>Hủy</button><button class="admin-button primary" type="submit"><i class="ph ph-floppy-disk" aria-hidden="true"></i><span data-submit-label>Lưu thay đổi</span></button></footer></form></dialog>
  </section><script>import "@/scripts/admin-operations";</script>
</AdminLayout>
