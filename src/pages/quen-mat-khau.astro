---
import AuthLayout from "@/layouts/AuthLayout.astro";
import AuthShell from "@/components/AuthShell.astro";
---

<AuthLayout title="Quên mật khẩu | THIÊN LỘC GROUP" description="Yêu cầu đặt lại mật khẩu tài khoản THIÊN LỘC GROUP.">
  <AuthShell title="Quên mật khẩu?" description="Nhập email đã dùng đăng ký. Chúng tôi sẽ gửi hướng dẫn đặt lại mật khẩu nếu thông tin hợp lệ.">
    <div class="auth-form-panel" data-form-panel>
      <form class="auth-form" data-auth-form="forgot" novalidate>
        <div class="field" data-field>
          <label for="forgot-email">Email</label>
          <input id="forgot-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" required aria-describedby="forgot-email-error" aria-errormessage="forgot-email-error" />
          <p class="field-error" id="forgot-email-error" data-field-error aria-live="polite"></p>
        </div>
        <button class="button button-primary auth-submit" type="submit" aria-busy="false" data-loading-label="Đang gửi hướng dẫn">
          <i class="ph ph-circle-notch button-loader" aria-hidden="true"></i>
          <span class="button-label">Gửi hướng dẫn</span>
        </button>
      </form>
      <p class="auth-secondary"><a class="auth-link" href="/dang-nhap"><i class="ph ph-arrow-left" aria-hidden="true"></i> Quay lại đăng nhập</a></p>
    </div>

    <div class="auth-state auth-state-panel" data-state-sent data-tone="success" hidden>
      <div class="auth-state-icon"><i class="ph ph-envelope-simple" aria-hidden="true"></i></div>
      <h2>Kiểm tra hộp thư của bạn</h2>
      <p>Nếu email khớp với một tài khoản, bạn sẽ nhận được hướng dẫn đặt lại mật khẩu trong ít phút.</p>
      <a class="button button-primary" href="/dang-nhap">Về trang đăng nhập</a>
      <button class="auth-link" type="button" data-resend>Gửi lại email</button>
      <p class="resend-status" data-resend-status aria-live="polite"></p>
    </div>
  </AuthShell>
</AuthLayout>
